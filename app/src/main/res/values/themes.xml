<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BookQuest" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/status_bar</item>
    </style>

    <!--
      What the window manager paints between the icon being tapped and the app
      drawing its first frame. It inherits the real theme, so the activity is
      running under an AppCompat theme from the very first moment; MainActivity
      swaps the background out for the app's own before it draws.
    -->
    <style name="Theme.BookQuest.Launch" parent="Theme.BookQuest">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
